rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    match /mfr_users/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /mfr_job_cards/{jobCardNo} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /mfr_movements/{movementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /mfr_notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /mfr_audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /mfr_company_config/{configId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /mfr_items/{itemId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /mfr_outsource_orders/{orderId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
  }
}
