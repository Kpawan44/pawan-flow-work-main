rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for User Identity & RBAC
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc(uid) {
      return get(/databases/$(database)/documents/mfr_users/$(uid)).data;
    }

    function hasUserDoc(uid) {
      return exists(/databases/$(database)/documents/mfr_users/$(uid));
    }

    // A valid user MUST be authenticated, have a physical mfr_users/{uid} document, and be active == true
    // Missing user document or inactive user = STRICT DENIAL
    function isActiveUser() {
      return isAuthenticated() && hasUserDoc(request.auth.uid) && getUserDoc(request.auth.uid).active == true;
    }

    function getUserRole() {
      return hasUserDoc(request.auth.uid) ? getUserDoc(request.auth.uid).role : '';
    }

    function isSuperAdmin() {
      return isActiveUser() && getUserRole() == 'super_admin';
    }

    function isAdmin() {
      return isActiveUser() && (
        getUserRole() == 'admin' || 
        getUserRole() == 'super_admin'
      );
    }

    function isManager() {
      return isActiveUser() && (
        getUserRole() == 'manager' || 
        getUserRole() == 'admin' || 
        getUserRole() == 'super_admin'
      );
    }

    function getUserDepartment() {
      return hasUserDoc(request.auth.uid) ? getUserDoc(request.auth.uid).department : '';
    }

    // Audit logs strictly require request.auth.uid as the authoritative actor identity
    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'timestamp', 'userId', 'userName', 'action', 'details']) &&
             data.id is string &&
             data.userId is string &&
             data.userName is string &&
             data.action is string &&
             data.details is string &&
             data.userId == request.auth.uid;
    }

    // Connection test document for health checks
    match /test/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Collection: User Credentials (PIN hashes) - Backend Admin SDK ONLY
    match /mfr_user_credentials/{uid} {
      allow read, write: if false;
    }

    // Collection: User Profiles (mfr_users)
    // Sanitized public profiles (never contains PINs, passwords, or credentials)
    match /mfr_users/{userId} {
      allow read: if isActiveUser();
      
      // Creating users: Only super_admin or admin (admin cannot create super_admin)
      allow create: if isSuperAdmin() || (isAdmin() && request.resource.data.role != 'super_admin');
      
      // Updating users:
      // - super_admin can update any field
      // - admin can update non-super_admin users (cannot promote to super_admin)
      // - self user can only update safe personal profile fields, NEVER role, department, active, createdAt, createdBy, or userId
      allow update: if isSuperAdmin() || (
        isAdmin() && 
        resource.data.role != 'super_admin' && 
        request.resource.data.role != 'super_admin'
      ) || (
        isActiveUser() && 
        request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'department', 'allowedDepartments', 'accessList', 
          'isDepartmentHead', 'canOutsource', 'active', 'status', 
          'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'userId'
        ])
      );

      // Deleting users: Only super_admin
      allow delete: if isSuperAdmin();
    }

    // Collection: Manufacturing Job Cards
    // Protected against arbitrary modification of immutable fields (jobCardNo, createdAt, createdBy, orderQty)
    match /mfr_job_cards/{jobCardNo} {
      allow read: if isActiveUser();
      
      allow create: if isActiveUser() && 
                    request.resource.data.keys().hasAll(['jobCardNo', 'itemName', 'orderQty', 'status']) &&
                    request.resource.data.orderQty > 0;

      allow update: if isActiveUser() && (
        isAdmin() || (
          request.resource.data.jobCardNo == resource.data.jobCardNo &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.orderQty == resource.data.orderQty
        )
      );

      allow delete: if isSuperAdmin();
    }

    // Collection: Material Movements (Physical Ledger)
    // Strictly requires positive quantities and movement metadata; immutable fields cannot be changed on update
    match /mfr_movements/{movementId} {
      allow read: if isActiveUser();
      
      allow create: if isActiveUser() && 
                    request.resource.data.quantity > 0 && 
                    request.resource.data.keys().hasAll(['movementId', 'jobCardNo', 'fromDepartment', 'toDepartment', 'quantity', 'transferDate']);

      allow update: if isActiveUser() && (
        isAdmin() || (
          request.resource.data.movementId == resource.data.movementId &&
          request.resource.data.jobCardNo == resource.data.jobCardNo &&
          request.resource.data.fromDepartment == resource.data.fromDepartment &&
          request.resource.data.toDepartment == resource.data.toDepartment &&
          request.resource.data.quantity == resource.data.quantity &&
          request.resource.data.transferDate == resource.data.transferDate &&
          request.resource.data.initiatedByUserId == resource.data.initiatedByUserId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'accepted', 'acceptedBy', 'acceptedDate', 'acceptedByUserId', 'remarks', 
            'allottedLocation', 'rackNo', 'issueStatus', 'modifiedByUserId', 'modifiedByUserName', 
            'modifiedDate', 'modifiedAction', 'deletedDate', 'deletedByUserId', 'deletedByUserName'
          ])
        )
      );

      allow delete: if isSuperAdmin();
    }

    // Collection: Idempotency Keys (Deduplication store)
    // Client cannot create arbitrary keys to manipulate workflows; backend Admin SDK manages idempotency records
    match /mfr_idempotency_keys/{keyId} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    // Collection: Audit Logs (Immutable write-once audit trails)
    // Strictly append-only: Updates and Deletions are forbidden; Authoritative actor must match request.auth.uid
    match /mfr_audit_logs/{logId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && isValidAuditLog(request.resource.data);
      allow update, delete: if false;
    }

    // Collection: Application Notifications
    match /mfr_notifications/{notificationId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update: if isActiveUser() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
      );
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // Collection: Company Configuration & Master Seeds
    match /mfr_company_config/{configId} {
      allow read: if isActiveUser();
      allow write: if isAdmin() || isSuperAdmin();
    }

    // Collection: Saved Items Autocomplete
    match /mfr_items/{itemId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // Collection: Process Outsource Orders
    match /mfr_outsource_orders/{orderId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && request.resource.data.orderQty > 0;
      allow update: if isActiveUser();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    match /mfr_process_transfers/{transferId} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    match /mfr_system_state/{docId} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    match /mfr_deleted_users/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /mfr_deleted_job_cards/{jobCardNo} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /mfr_deleted_movements/{movementId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /mfr_rm_sku_master/{code} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }
  }
}
